{
  "name": "slowficlock",
  "version": "1.0.0",
  "private": true,
  "description": "SlowfiClock: a slow lofi focus clock. Web app in web/, phone apps through Capacitor.",
  "scripts": {
    "catalog": "python3 tools/build_catalog.py",
    "sync": "python3 tools/build_catalog.py && npx cap sync",
    "android": "npm run sync && npx cap open android"
  },
  "dependencies": {
    "@capacitor-community/keep-awake": "^8.0.1",
    "@capacitor/android": "^8.6.0",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.0",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.6.0",
    "@capacitor/splash-screen": "^8.0.2"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0"
  }
}
